{
  "name": "inline-css",
  "version": "5.0.0-rc.1",
  "description": "Inline css into an html file.",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "cheerio": "^1.2.0",
    "css-rules": "^2.0.0-rc.1",
    "extract-css": "^4.0.0-rc.1",
    "inline-css-template-blocks": "^1.0.0-rc.1",
    "resource-policy": "^1.0.0-rc.1",
    "specificity": "^1.0.0",
    "postcss-selector-parser": "^7.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/eslint-parser": "^7.26.5",
    "@changesets/cli": "^2.27.12",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "js-beautify": "^1.15.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "playwright": "1.65.0",
    "should": "^13.2.3",
    "turbo": "^2.4.0",
    "vinyl": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "mocha test packages/**/test",
    "lint": "eslint index.js lib/ packages/",
    "lint:fix": "eslint --fix index.js lib/ packages/",
    "coverage": "nyc npm test && nyc report",
    "changeset": "changeset",
    "release": "npm run release:check && node scripts/publish-release.js",
    "version:packages": "changeset version",
    "release:check": "npm run lint && npm test && node scripts/audit-release.js && node scripts/verify-packed-release.js",
    "release:pack": "node scripts/verify-packed-release.js",
    "release:audit": "node scripts/audit-release.js",
    "test:browser": "mocha test/browser.test.js",
    "release:preview": "node scripts/publish-release.js --dry-run"
  },
  "files": [
    "index.js",
    "lib/",
    "docs/migration-5.md"
  ],
  "repository": "jonkemp/inline-css",
  "keywords": [
    "inline",
    "css",
    "html",
    "email"
  ],
  "author": "Jonathan Kemp <kempdogg@gmail.com> (http://jonkemp.com/)",
  "license": "MIT",
  "packageManager": "npm@11.1.0",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "glob": "^14.0.2"
  }
}
